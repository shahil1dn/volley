# Every setting Volley reads, with where it comes from. Copy to .env.local (never commit that
# file), or let `npm run setup` fill it in. `npm run doctor` checks it. An AI agent: read
# this file first, then run `npm run doctor`.
#
# Values here are empty on purpose. Setup never prints a value; this file never holds one.

# ---- Made by `npm run setup` (long random secrets; keep them private) --------------------
# Signs host session cookies and sign-in rate-limit keys. Changing it signs every host out.
HOST_SESSION_SECRET=
# Signs the anonymous participant cookie and hashes phones' IP addresses.
PARTICIPANT_SECRET=
# Lets Vercel Cron call /api/cron/keep-alive. Only the Production deployment reads it.
CRON_SECRET=

# ---- From your Supabase project (dashboard, or the Vercel Supabase store) -----------------
# The project's API address: https://<ref>.supabase.co
SUPABASE_URL=
# Server-only key for the Auth admin API (making hosts and invites). Never goes to a browser.
SUPABASE_SECRET_KEY=
# The app's database connection: Supabase's TRANSACTION POOLER (host ends .pooler.supabase.com,
# port 6543). Dashboard -> Connect -> Transaction pooler. Not the direct connection.
POSTGRES_URL=
# Direct (or session-pooler) connection, used only by scripts (migrations, first host).
POSTGRES_URL_NON_POOLING=
# The project's publishable (anon) key, safe to expose. The Vercel Supabase store names it
# NEXT_PUBLIC_...; SvelteKit only reads the PUBLIC_ prefix, so `npm run setup` copies it.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Optional ----------------------------------------------------------------------------
# Lets scripts/load/* through a protected Vercel preview. Not read by the app.
VERCEL_AUTOMATION_BYPASS_SECRET=
# A Supabase personal access token, only for `npm run setup -- --disable-signup`
# (dashboard -> Account -> Access Tokens). Without it, a person turns sign-up off by hand.
SUPABASE_ACCESS_TOKEN=
