{
  "name": "aib-live",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo \"\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --env-file-if-exists=.env.local --import ./tests/refuse-production.ts --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "add-host": "node --env-file-if-exists=.env.local scripts/add-host.mjs",
    "set-host": "node --env-file-if-exists=.env.local scripts/set-host.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/functions": "^3.9.9",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "type": "module"
}
